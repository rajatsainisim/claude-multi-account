}


def show_help(topic=None):
    key = {"account": "accounts", "switch": "accounts", "status": "usage", "auto-switch": "auto",
           "file": "files", "run": "parallel", "map": "parallel", "wrapper": "parallel",
           "sessions": "parallel", "export": "move", "import": "move"}.get(topic, topic) or "overview"
    print(HELP.get(key) or f"No help topic '{topic}'. Topics: accounts, usage, auto, parallel, files\n\n" + HELP["overview"])


def main(argv):
    if not argv and sys.stdin.isatty():
        pick()
        return
    cmd, args = (argv[0], argv[1:]) if argv else ("list", [])
    if cmd in ("help", "-h", "--help"):
        show_help(args[0] if args else None)
    elif cmd == "save":
        print(f"Saved as {save(args[0] if args else None)}")
    elif cmd == "use" and args:
        use(resolve(args[0]))
    elif cmd == "list":
        listing("--json" in args)
    elif cmd == "autosave":
        autosave()
    elif cmd == "current":
        print(active_name() or "(not saved)")
    elif cmd == "add-token" and args:
        add_token(args[0])
    elif cmd == "auto":
        auto_cmd(args)
    elif cmd == "hook" and args:
        hook(args[0])
    elif cmd in ("disable", "enable") and args:
        set_disabled(args[0], cmd == "disable")
    elif cmd == "run":
        run(args)
    elif cmd == "map":
        map_cmd(args)
    elif cmd == "unmap":
        map_cmd(args, remove=True)
    elif cmd in ("sessions", "maps"):
        sessions_cmd() if cmd == "sessions" else map_cmd([])
    elif cmd == "wrapper":
        wrapper_cmd(args)
    elif cmd == "timezone":
        timezone_cmd(args)
    elif cmd == "export":
        export_cmd(args)
    elif cmd == "import":
        import_cmd(args)
    elif cmd == "move":
        move_cmd(args)
    elif cmd == "remove" and args:
        name = resolve(args[0])
        if status_module().session_state(name) == "running":
            sys.exit(f"{name} is in use in a parallel session; close it first.")
        backup(name)  # a copy stays in .backup in case it was a mistake
        (STORE / f"{name}.json").unlink()
        print(f"Removed {name} (a backup is in {STORE / '.backup'})")
    else:
        print(f"Unknown command: {' '.join(argv)}\n", file=sys.stderr)
        show_help()
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
